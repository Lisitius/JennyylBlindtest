# Modele de configuration — copier vers .env.local et remplir.
# .env.local n'est JAMAIS versionne (voir .gitignore).

# --- Supabase (comptes joueurs et salons multijoueur) ---
# Tableau de bord Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle "passe-partout" : cote serveur uniquement, jamais envoyee au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Signature des cookies de session ---
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# --- Envoi d'emails (mot de passe oublie) — facultatif ---
# Sans ces valeurs, l'envoi integre de Supabase prend le relais
# (fonctionnel mais limite a quelques emails par heure).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Blindtest de JennyyL
